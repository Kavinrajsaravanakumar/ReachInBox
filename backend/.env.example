PORT=3000
NODE_ENV=development
LOG_LEVEL=info
API_BASE_URL=http://localhost:3000

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
DEV_AUTH_ENABLED=true
ADMIN_TOKEN=

DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=30
# MAX_EMAILS_PER_HOUR_PER_SENDER=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:3000/api/slack/oauth/callback
SLACK_SCOPES=incoming-webhook,chat:write

OAUTH_SUCCESS_REDIRECT=http://localhost:3001/auth/callback
